<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>我们的甜蜜网页</title>
  <style>
    /* 基本重置与全局样式 */
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }
    body {
      font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
      background-color: #fff0f6;
      color: #4a4a4a;
      line-height: 1.6;
      padding-bottom: 50px;
    }
    header {
      background-color: #ffe0f0;
      padding: 10px 20px;
      text-align: center;
      border-bottom: 1px solid #ffccd9;
    }
    header nav a {
      margin: 0 10px;
      color: #d6336c;
      text-decoration: none;
      font-weight: bold;
    }
    header nav a:hover {
      text-decoration: underline;
    }
    main {
      max-width: 800px;
      margin: 20px auto;
      padding: 0 10px;
    }
    section {
      margin-bottom: 40px;
      padding: 20px;
      background-color: #ffffff;
      border-radius: 8px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.05);
    }
    section h2 {
      margin-bottom: 15px;
      color: #d6336c;
    }
    form {
      margin-bottom: 20px;
    }
    form input, form select, form textarea, form button {
      width: 100%;
      padding: 8px;
      margin-bottom: 10px;
      border: 1px solid #ffccd9;
      border-radius: 4px;
      font-size: 14px;
    }
    form button {
      background-color: #ffccd9;
      color: #fff;
      border: none;
      cursor: pointer;
    }
    form button:hover {
      background-color: #d6336c;
    }
    .entry-list, .travel-list, .record-list {
      list-style: none;
    }
    .entry-list li, .travel-list li, .record-list li {
      padding: 8px;
      border-bottom: 1px dashed #ffccd9;
    }
    canvas {
      background-color: #fff;
      border: 1px solid #ffccd9;
      border-radius: 4px;
      margin-top: 10px;
    }
    .quiz-question {
      margin-bottom: 15px;
    }
    .quiz-question label {
      display: block;
      margin-bottom: 5px;
    }
    .result {
      margin-top: 10px;
      padding: 10px;
      background-color: #ffccd9;
      color: #fff;
      border-radius: 4px;
      text-align: center;
      font-weight: bold;
    }
  </style>
</head>
<body>
  <header>
    <nav>
      <a href="#diary">我们的甜蜜日记</a>
      <a href="#travel">我们的旅行计划</a>
      <a href="#quiz">互动小测试</a>
      <a href="#records">乖乖的书影音记录</a>
    </nav>
  </header>
  <main>
    <!-- 甜蜜日记模块 -->
    <section id="diary">
      <h2>我们的甜蜜日记</h2>
      <form id="diary-form">
        <label for="diary-date">日期</label>
        <input type="date" id="diary-date" required value="">
        <label for="diary-mood">心情评分（1-10）</label>
        <input type="number" id="diary-mood" min="1" max="10" required>
        <label for="diary-text">日记内容</label>
        <textarea id="diary-text" rows="3" placeholder="写下今天的点滴……" required></textarea>
        <button type="submit">添加日记</button>
      </form>
      <ul id="diary-entries" class="entry-list"></ul>
      <h3>心情曲线</h3>
      <canvas id="mood-canvas" width="760" height="200"></canvas>
    </section>

    <!-- 旅行计划模块 -->
    <section id="travel">
      <h2>我们的旅行计划</h2>
      <form id="travel-form">
        <input type="text" id="travel-destination" placeholder="输入你们想去的地方" required>
        <button type="submit">添加目的地</button>
      </form>
      <ul id="travel-list" class="travel-list"></ul>
    </section>

    <!-- 互动小测试模块 -->
    <section id="quiz">
      <h2>互动小测试</h2>
      <form id="quiz-form">
        <div class="quiz-question">
          <label>1. 你觉得我最喜欢的颜色是？</label>
          <label><input type="radio" name="q1" value="a" required> 粉红</label>
          <label><input type="radio" name="q1" value="b"> 蓝色</label>
          <label><input type="radio" name="q1" value="c"> 绿色</label>
        </div>
        <div class="quiz-question">
          <label>2. 我最爱的甜点是哪一种？</label>
          <label><input type="radio" name="q2" value="a" required> 巧克力蛋糕</label>
          <label><input type="radio" name="q2" value="b"> 草莓慕斯</label>
          <label><input type="radio" name="q2" value="c"> 蓝莓芝士</label>
        </div>
        <div class="quiz-question">
          <label>3. 当遇到难题时，我通常会：</label>
          <label><input type="radio" name="q3" value="a" required> 咨询朋友</label>
          <label><input type="radio" name="q3" value="b"> 静下心来思考</label>
          <label><input type="radio" name="q3" value="c"> 找网络答案</label>
        </div>
        <button type="submit">提交测试</button>
      </form>
      <div id="quiz-result" class="result" style="display:none;"></div>
    </section>

    <!-- 书影音记录模块 -->
    <section id="records">
      <h2>乖乖的书影音记录</h2>
      <form id="record-form">
        <select id="record-type" required>
          <option value="">选择类型</option>
          <option value="书">书</option>
          <option value="电影">电影</option>
          <option value="游戏">游戏</option>
        </select>
        <input type="text" id="record-title" placeholder="标题" required>
        <textarea id="record-comment" rows="2" placeholder="简单评论"></textarea>
        <button type="submit">添加记录</button>
      </form>
      <ul id="record-list" class="record-list"></ul>
    </section>
  </main>
  
  <script>
    // 日记模块 JavaScript
    (function() {
      const diaryForm = document.getElementById('diary-form');
      const diaryEntriesEl = document.getElementById('diary-entries');
      const moodCanvas = document.getElementById('mood-canvas');
      const ctx = moodCanvas.getContext('2d');
      let diaryEntries = JSON.parse(localStorage.getItem('diaryEntries')) || [];

      // 初始化日期默认值为今天
      document.getElementById('diary-date').valueAsDate = new Date();

      function saveDiary() {
        localStorage.setItem('diaryEntries', JSON.stringify(diaryEntries));
      }

      function renderDiaryEntries() {
        diaryEntriesEl.innerHTML = '';
        diaryEntries.sort((a, b) => new Date(a.date) - new Date(b.date));
        diaryEntries.forEach((entry, index) => {
          const li = document.createElement('li');
          li.textContent = `${entry.date} - 心情评分：${entry.mood} - ${entry.text}`;
          diaryEntriesEl.appendChild(li);
        });
      }

      function drawMoodChart() {
        // 清空画布
        ctx.clearRect(0, 0, moodCanvas.width, moodCanvas.height);
        if(diaryEntries.length === 0) return;
        // 简单绘制坐标轴
        ctx.strokeStyle = "#ffccd9";
        ctx.lineWidth = 2;
        ctx.beginPath();
        ctx.moveTo(40, 10);
        ctx.lineTo(40, moodCanvas.height - 30);
        ctx.lineTo(moodCanvas.width - 10, moodCanvas.height - 30);
        ctx.stroke();

        // 绘制心情曲线（日期按时间均分）
        diaryEntries.sort((a, b) => new Date(a.date) - new Date(b.date));
        const count = diaryEntries.length;
        const xStep = (moodCanvas.width - 60) / (count - 1);
        ctx.strokeStyle = "#d6336c";
        ctx.lineWidth = 2;
        ctx.beginPath();
        diaryEntries.forEach((entry, i) => {
          const x = 40 + i * xStep;
          // y轴范围为 1~10 映射到画布高度
          const y = ((10 - entry.mood) / 9) * (moodCanvas.height - 40) + 10;
          if(i === 0){
            ctx.moveTo(x, y);
          } else {
            ctx.lineTo(x, y);
          }
          // 标记点
          ctx.fillStyle = "#d6336c";
          ctx.beginPath();
          ctx.arc(x, y, 3, 0, Math.PI * 2);
          ctx.fill();
        });
        ctx.stroke();
      }

      diaryForm.addEventListener('submit', function(e) {
        e.preventDefault();
        const date = document.getElementById('diary-date').value;
        const mood = Number(document.getElementById('diary-mood').value);
        const text = document.getElementById('diary-text').value;
        diaryEntries.push({ date, mood, text });
        saveDiary();
        renderDiaryEntries();
        drawMoodChart();
        diaryForm.reset();
        document.getElementById('diary-date').valueAsDate = new Date();
      });

      // 初始化加载
      renderDiaryEntries();
      drawMoodChart();
    })();

    // 旅行计划模块 JavaScript
    (function() {
      const travelForm = document.getElementById('travel-form');
      const travelListEl = document.getElementById('travel-list');
      let travelList = JSON.parse(localStorage.getItem('travelList')) || [];

      function saveTravelList() {
        localStorage.setItem('travelList', JSON.stringify(travelList));
      }

      function renderTravelList() {
        travelListEl.innerHTML = '';
        travelList.forEach((destination, index) => {
          const li = document.createElement('li');
          // 链接到 Google Maps 搜索页面
          const a = document.createElement('a');
          a.href = 'https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent(destination);
          a.target = '_blank';
          a.textContent = destination;
          li.appendChild(a);
          travelListEl.appendChild(li);
        });
      }

      travelForm.addEventListener('submit', function(e) {
        e.preventDefault();
        const destination = document.getElementById('travel-destination').value.trim();
        if(destination) {
          travelList.push(destination);
          saveTravelList();
          renderTravelList();
          travelForm.reset();
        }
      });

      renderTravelList();
    })();

    // 互动小测试模块 JavaScript
    (function() {
      const quizForm = document.getElementById('quiz-form');
      const quizResultEl = document.getElementById('quiz-result');
      // 预设答案，仅供参考，可根据实际情况调整
      const correctAnswers = {
        q1: 'a', // 最喜欢的颜色：粉红
        q2: 'b', // 最爱的甜点：草莓慕斯
        q3: 'b'  // 遇到难题：静下心来思考
      };

      quizForm.addEventListener('submit', function(e) {
        e.preventDefault();
        const formData = new FormData(quizForm);
        let score = 0;
        let total = 3;
        for(let [key, value] of formData.entries()){
          if(correctAnswers[key] === value){
            score++;
          }
        }
        const percentage = Math.round((score / total) * 100);
        quizResultEl.style.display = 'block';
        quizResultEl.textContent = `你的默契指数：${percentage}%`;
      });
    })();

    // 书影音记录模块 JavaScript
    (function() {
      const recordForm = document.getElementById('record-form');
      const recordListEl = document.getElementById('record-list');
      let records = JSON.parse(localStorage.getItem('records')) || [];

      function saveRecords() {
        localStorage.setItem('records', JSON.stringify(records));
      }

      function renderRecords() {
        recordListEl.innerHTML = '';
        records.forEach((record, index) => {
          const li = document.createElement('li');
          li.textContent = `[${record.type}] ${record.title} - ${record.comment}`;
          recordListEl.appendChild(li);
        });
      }

      recordForm.addEventListener('submit', function(e) {
        e.preventDefault();
        const type = document.getElementById('record-type').value;
        const title = document.getElementById('record-title').value.trim();
        const comment = document.getElementById('record-comment').value.trim();
        if(type && title) {
          records.push({ type, title, comment });
          saveRecords();
          renderRecords();
          recordForm.reset();
        }
      });

      renderRecords();
    })();
  </script>
</body>
</html>
